{
  "name": "customs-cruncher",
  "version": "6.1.3",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx index.ts",
    "check:db": "bun scripts/csvImport.ts missing-from-db",
    "check:csv": "bun scripts/csvImport.ts missing-from-csv",
    "check:match": "bun scripts/csvImport.ts check-matches",
    "import:csv": "bun scripts/csvImport.ts import-csv",
    "csv:help": "bun scripts/csvImport.ts --help",
    "migrate:sqlite": "bun scripts/migrateFromSqlite.ts",
    "db:sync": "bun scripts/syncDb.ts",
    "db:dev-to-prod": "bun scripts/syncDb.ts dev-to-prod",
    "db:prod-to-dev": "bun scripts/syncDb.ts prod-to-dev",
    "reimport:replays": "bun scripts/reimportReplays.ts",
    "reimport:replays:dev": "bun scripts/reimportReplays.ts :dev",
    "reparse:takedowns": "bun scripts/reimportReplays.ts",
    "reparse:takedowns:dev": "bun scripts/reimportReplays.ts :dev",
    "start": "bun run build:web && echo \"Current version: v$npm_package_version\"; echo \"v$npm_package_version\" > .running_version; sudo systemctl start customs-cruncher.service",
    "stop": "R=$(cat .running_version 2>/dev/null || echo 'unknown'); echo \"Current version: v$npm_package_version\"; echo \"Stopped version: $R\"; sudo systemctl stop customs-cruncher.service",
    "status": "R=$(cat .running_version 2>/dev/null || echo 'unknown'); echo \"Current version: v$npm_package_version\"; echo \"Running version: $R\"; systemctl status customs-cruncher.service --no-pager",
    "logs": "tail -f out.log",
    "logs:all": "less +F out.log",
    "restart": "bun run build:web && bun stop && sleep 2 && bun start",
    "build:web": "vite build",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext .ts",
    "test": "bun test ./commands ./server ./store ./utils",
    "postinstall": "node node_modules/heroprotocol/postinstall.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@meadowsjared/hots-parser": "github:meadowsjared/hots-parser",
    "csv-parse": "^7.0.3",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "postgres": "^4.1.1",
    "puppeteer": "^25.18.1",
    "puppeteer-real-browser": "^1.4.4",
    "regenerator-runtime": "^0.14.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "@types/sharp": "^0.32.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
